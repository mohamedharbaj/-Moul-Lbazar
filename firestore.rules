rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all: no collection is open by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Submissions collection
    match /submissions/{submissionId} {
      // Helper function to check if caller is the authorized admin
      function isAuthorizedAdmin() {
        return request.auth != null &&
               request.auth.token.email.lower() == 'moullbazar.ma@gmail.com';
      }

      // Helper function to validate incoming submission payload created by visitors
      function isValidNewSubmission() {
        let data = request.resource.data;
        return data.keys().hasAll([
                 'referenceCode',
                 'fullName',
                 'city',
                 'phone',
                 'categoryId',
                 'categoryTitle',
                 'description',
                 'photos',
                 'status',
                 'createdAt',
                 'expiresAt'
               ]) &&
               data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
               data.city is string && data.city.size() >= 2 && data.city.size() <= 100 &&
               data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 25 &&
               data.categoryId is string && data.categoryId.size() <= 60 &&
               data.categoryTitle is string && data.categoryTitle.size() <= 100 &&
               data.description is string && data.description.size() >= 10 && data.description.size() <= 3000 &&
               data.status == 'pending' &&
               data.photos is list && data.photos.size() >= 1 && data.photos.size() <= 20;
      }

      // Public visitors can ONLY create new submissions
      allow create: if isValidNewSubmission();

      // Only the verified authorized admin can read (get/list), update, or delete submissions
      allow read: if isAuthorizedAdmin();
      allow update: if isAuthorizedAdmin();
      allow delete: if isAuthorizedAdmin();
    }
  }
}
